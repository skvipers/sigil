; 'Виселица: угадайте слово по буквам, 6 ошибок и проигрыш'

%words = ['цикл', 'индекс', 'список', 'строка', 'сигил']
%alphabet = 'абвгдеёжзийклмнопрстуфхцчшщъыьэюя'
%faces = ['x_x', 'o_x', 'o_O', 'o_o', '-_-', '^_^', ':)'] ; 'лицо по числу оставшихся жизней 0..6'

; 'Слово с буквами, которые уже угаданы, и _ вместо остальных'
$mask(%word, %guessed):
	%shown = ''
	%i = 0
	@%i < #len(%word):
		? %word[%i] ~ %guessed: ; 'буква среди названных'
			%shown = %shown + %word[%i]
		>
			%shown = %shown + '_'
		%i = %i + 1
	:< %shown

%word = %words[#rnd(0, #len(%words) - 1)]
%guessed = []
%lives = 6
%shown = $mask(%word, %guessed)

>:E2 'ВИСЕЛИЦА'
>: 'Слово из ' + #len(%word) + ' букв. Ошибиться можно 6 раз.'

@%lives > 0 & '_' ~ %shown: ; 'играем, пока есть жизни и остались неотгаданные буквы'
	>: ''
	>: %faces[%lives] + '  ' + %shown + '   жизни: ' + %lives
	>: 'Названы: ' + %guessed
	>:E2 'Ваша буква:'
	%ch = <:
	%ch = #lower(%ch)
	@#len(%ch) != 1 | %ch !~ %alphabet | %ch ~ %guessed:
		>: 'Нужна одна новая русская буква:'
		%ch = <:
		%ch = #lower(%ch)

	%guessed = #add(%guessed, %ch)
	? %ch ~ %word:
		>:I6 'Есть такая буква!'
	>
		%lives = %lives - 1
		>:A7 'Нет такой буквы'
	%shown = $mask(%word, %guessed)

>: ''
? '_' !~ %shown:
	>:I6 'Вы выиграли! Слово: ' + %word
>
	>:A7 'Вы проиграли. Слово было: ' + %word
