; 'Сумма чисел из одной строки: #split режет текст, #num делает из кусков числа'
>: 'Числа через пробел:'
%line = <:
%parts = #split(%line, ' ')
%sum = 0
%count = 0
%i = 0
@%i < #len(%parts):
	? %parts[%i] != '': ; 'двойные пробелы дают пустые куски, пропускаем'
		%sum = %sum + #num(%parts[%i])
		%count = %count + 1
	%i = %i + 1
>: 'Чисел: ' + %count + ', сумма: ' + %sum
