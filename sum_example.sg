; 'Сумма чисел из одной строки: #split режет текст, #isnum проверяет кусок, #num делает число'
>: 'Числа через пробел:'
%line = <:
%sum = 0
%count = 0
@%part : #split(%line, ' '): ; 'цикл по кускам строки'
	? #isnum(%part):
		%sum = %sum + #num(%part)
		%count = %count + 1
	> ? %part != '': ; 'пустые куски от двойных пробелов молча пропускаем'
		>:A7 'Пропущено, это не число: ' + %part
>: 'Чисел: ' + %count + ', сумма: ' + %sum
