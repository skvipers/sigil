; 'Сумма чисел из одной строки: #split режет текст, #isnum проверяет кусок, #num делает число'
>: 'Числа через пробел:'
%line = <:
%parts = #split(%line, ' ')
%sum = 0
%count = 0
%i = 0
@%i < #len(%parts):
	? #isnum(%parts[%i]):
		%sum = %sum + #num(%parts[%i])
		%count = %count + 1
	> ? %parts[%i] != '': ; 'пустые куски от двойных пробелов молча пропускаем'
		>:A7 'Пропущено, это не число: ' + %parts[%i]
	%i = %i + 1
>: 'Чисел: ' + %count + ', сумма: ' + %sum
