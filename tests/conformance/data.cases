=== list-literal-and-printing
--- sg
>: [1, 'a', 2.5]
>: []
>: [[1, 2], ['x']]
--- out
[1, 'a', 2.5]
[]
[[1, 2], ['x']]

=== list-and-text-indexing-from-zero
--- sg
%l = [10, 20, 30]
>: %l[0]
>: %l[2]
%m = [[1, 2], [3, 4]]
>: %m[1][0]
>: 'abc'[1]
--- out
10
30
3
b

=== list-element-assignment
--- sg
%l = [1, 2, 3]
%l[1] = 'x'
>: %l
%l[#len(%l) - 1] = 0
>: %l
%m = [[1, 2], [3, 4]]
%m[1][0] = 9
>: %m
--- out
[1, 'x', 3]
[1, 'x', 0]
[[1, 2], [9, 4]]

=== lists-are-values-assignment-copies
--- sg
%a = [1, 2]
%b = %a
%b[0] = 99
>: %a
>: %b
--- out
[1, 2]
[99, 2]

=== lists-are-values-copy-is-deep
--- sg
%a = [[1], [2]]
%b = %a
%b[0][0] = 99
>: %a
>: %b
--- out
[[1], [2]]
[[99], [2]]

=== lists-are-values-literal-copies-its-parts
--- sg
%a = [1]
%b = [%a, %a]
%a[0] = 5
%b[0][0] = 7
>: %a
>: %b
--- out
[5]
[[7], [1]]

=== lists-are-values-function-parameter-is-a-copy
--- sg
$f(%l):
    %l[0] = 99
    :< %l
%a = [1, 2]
%r = $f(%a)
>: %a
>: %r
--- out
[1, 2]
[99, 2]

=== lists-are-values-function-cannot-change-a-global-list
--- sg
%g = [1, 2]
$f():
    %g[0] = 99
    :< %g[0]
>: $f()
>: %g
--- out
99
[1, 2]

=== add-returns-a-new-list
--- sg
%a = [1]
%b = #add(%a, 2)
>: %a
>: %b
%l = []
@%i : [0, 1, 2]:
    %l = #add(%l, %i * 10)
>: %l
--- out
[1]
[1, 2]
[0, 10, 20]

=== list-operators
--- sg
>: [1] + [2, 3]
>: [0] * 3
>: 'L: ' + [1, 'a']
>: [1, 2] == [1, 2]
>: [1, 2] == [2, 1]
--- out
[1, 2, 3]
[0, 0, 0]
L: [1, 'a']
True
False

=== empty-list-is-false
--- sg
? []:
    >: 'yes'
>
    >: 'no'
? [0]:
    >: 'yes'
>
    >: 'no'
--- out
no
yes

=== membership-text-is-substring-list-is-element
--- sg
>: 'r' ~ 'rps'
>: 'x' ~ 'rps'
>: 'x' !~ 'rps'
>: 'rp' ~ 'rps'
>: '' ~ 'rps'
>: '' !~ 'rps'
>: 'b' ~ ['a', 'b']
>: 'a' ~ ['abc']
>: 2 ~ [1, 2, 3]
>: 1 ~ ['1']
>: '' ~ ['']
>: '' ~ []
--- out
True
False
True
True
False
True
True
False
True
True
True
False

=== len
--- sg
>: #len('hello')
>: #len('')
>: #len('привет')
>: #len(12345)
>: #len([1, 2, 3])
>: #len([])
--- out
5
0
6
5
3
0

=== lower-and-upper
--- sg
>: #lower('HeLLo')
>: #upper('HeLLo')
>: #lower('ПРИВЕТ')
>: #upper('привет')
>: #lower(5) + 1
--- out
hello
HELLO
привет
ПРИВЕТ
51

=== split-and-join
--- sg
>: #split('a,b,c', ',')
>: #split('a,,b', ',')
>: #split('', ',')
>: #split('abc', '')
>: #split('', '')
>: #split(12345, 3)
>: #join([1, 'a', 2.5], ', ')
>: #join([], '-')
>: #join(#split('цикл индекс', ' '), '+')
--- out
['a', 'b', 'c']
['a', '', 'b']
['']
['a', 'b', 'c']
[]
['12', '45']
1, a, 2.5

цикл+индекс

=== num-and-isnum
--- sg
>: #num('42')
>: #num(' -7 ')
>: #num('2.5')
>: #num('.5')
>: #num('5.')
>: #num('007')
>: #num(5)
>: #isnum('42')
>: #isnum('1,5')
>: #isnum('1e5')
>: #isnum('abc')
>: #isnum('')
>: #isnum([1])
>: #isnum(true)
--- out
42
-7
2.5
0.5
5.0
7
5
True
False
False
False
False
False
False

=== split-pieces-are-text-until-converted
--- sg
>: #split('1,2', ',')[0] + 1
>: #num(#split('1,2', ',')[0]) + 1
--- out
11
2

=== rnd-forms-with-a-single-possible-result
--- sg
>: #rnd(5, 5)
>: #rnd('a')
>: #rnd(3, 'a')
--- out
5
a
aaa
