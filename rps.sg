; 'Камень-ножницы-бумага: играем до трёх побед'
; 'Жесты: r - камень, p - бумага, s - ножницы'

$beats(%a, %b): ; 'побеждает ли жест %a жест %b'
	? %a == 'r' & %b == 's':
		:< true
	? %a == 's' & %b == 'p':
		:< true
	? %a == 'p' & %b == 'r':
		:< true
	:< false

$name(%g):
	? %g == 'r':
		:< 'камень'
	> ? %g == 'p':
		:< 'бумага'
	>
		:< 'ножницы'

%me_score = 0
%cpu_score = 0
%round = 0

>:E2 'КАМЕНЬ, НОЖНИЦЫ, БУМАГА'
>: 'Играем до 3 побед. Ход: r - камень, p - бумага, s - ножницы'

@%me_score < 3 & %cpu_score < 3:
	%round = %round + 1
	>:E2 'Раунд ' + %round + ', ваш ход (r/p/s):'
	%move = <:
	@%move !~ 'rps' | #len(%move) != 1: ; 'пока ввод - не ровно один символ из rps'
		>: 'Нужно r, p или s:'
		%move = <:

	%cpu = #rnd('rps')
	>: 'Вы: ' + $name(%move) + ', компьютер: ' + $name(%cpu)

	? %move == %cpu:
		>: 'Ничья'
	> ? $beats(%move, %cpu):
		%me_score = %me_score + 1
		>:I6 'Раунд ваш'
	>
		%cpu_score = %cpu_score + 1
		>:A7 'Раунд компьютера'
	>: 'Счёт ' + %me_score + ':' + %cpu_score

? %me_score == 3:
	>:I6 'Вы победили!'
>
	>:A7 'Компьютер победил'
