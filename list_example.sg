; 'Списки: [ ], индекс с нуля, значения (не ссылки)'
%nums = [5, 3, 8, 1]
>: 'Было: ' + %nums

; 'Сортировка пузырьком'
%n = #len(%nums)
%i = 0
@%i < %n:
	%j = 0
	@%j < %n - %i - 1:
		? %nums[%j] > %nums[%j + 1]:
			%t = %nums[%j]
			%nums[%j] = %nums[%j + 1]
			%nums[%j + 1] = %t
		%j = %j + 1
	%i = %i + 1
>: 'Стало: ' + %nums

; 'Присваивание копирует список'
%copy = %nums
%copy[0] = 100
>: 'Оригинал: ' + %nums + ', копия: ' + %copy

; '#add возвращает новый список, ~ ищет элемент'
%names = ['a', 'b']
%names = #add(%names, 'c')
>: %names
>: 'b' ~ %names
>: 'z' ~ %names
